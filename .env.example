# Шаблон переменных окружения. Это НЕ настоящие ключи — просто подсказка,
# какие переменные нужны и откуда их взять. Реальные значения задаются на
# хостинге (Render → Environment) или в docker-compose.yml, а не в этом файле.
# Копировать в .env для локального запуска НЕ обязательно — без Upstash
# сервер прекрасно работает с локальным файлом data/db.json (см. README).

# --- Upstash Redis (опционально) ---
# Нужен, только если сервер размещён на "засыпающем" бесплатном хостинге
# (Render, Railway и т.п.) — без него прогресс сбрасывается после того, как
# хостинг усыпит и пересоздаст контейнер. См. README, раздел
# "Хостинг, который засыпает" — там пошаговая настройка.
# Взять на странице базы в консоли upstash.com, вкладка "REST API".
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Необязательно: свой ключ в Upstash, если один аккаунт используется для
# нескольких окружений (например, тестового и боевого). По умолчанию —
# yahu-app-state.
# UPSTASH_REDIS_KEY=

# --- Инструмент разработчика (опционально) ---
# Пароль для входа в Профиль → Инструмент разработчика. По умолчанию, если не
# задано, используется B201190aU (см. server.js).
# DEV_TOOL_PASSWORD=

# --- Прочее (обычно не нужно менять) ---
# PORT=3000
# DATA_FILE=./data/db.json
