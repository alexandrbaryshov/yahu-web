# Зависимости (на случай, если в будущем появятся npm-пакеты)
node_modules/

# Рантайм-данные приложения — генерируются сервером при первом запуске,
# в репозитории быть не должны (у каждого окружения свои личные данные)
data/*
!data/.gitkeep

# Логи
*.log
npm-debug.log*

# ОС/редакторы
.DS_Store
Thumbs.db
.vscode/
.idea/

# Переменные окружения (если появятся локальные .env с секретами)
.env
.env.local
