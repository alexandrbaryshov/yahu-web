# Зависимости (на случай, если в будущем появятся npm-пакеты)
node_modules/

# Рантайм-данные приложения — генерируются сервером при первом запуске,
# в репозитории быть не должны (у каждого окружения свои личные данные)
data/*
!data/.gitkeep

# Логи
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Кэш/результат сборки — сейчас в проекте сборки нет (сервер отдаёт файлы
# напрямую), но пусть будет на случай, если она когда-нибудь появится
dist/
build/
.cache/

# ОС/редакторы
.DS_Store
Thumbs.db
.vscode/
.idea/
*~
*.swp
*.swo

# Переменные окружения (реальные секреты — UPSTASH_REDIS_REST_TOKEN и т.п.)
# .env.example — не секрет, это шаблон-подсказка, какие переменные нужны,
# поэтому он специально РАЗРЕШЁН исключением ниже.
.env
.env.*
!.env.example
